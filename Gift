<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#8b5cf6">
<title>Happy Raksha Bandhan ❤️</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');

:root{
  --bg1:#140b2d; --bg2:#35105b; --pink:#ff77b7; --purple:#9b7bff;
  --white:#fff; --muted:rgba(255,255,255,.78); --glass:rgba(255,255,255,.10);
  --border:rgba(255,255,255,.18);
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:"DM Sans",sans-serif;color:var(--white);background:#140b2d}
body{overflow-x:hidden}
button{font:inherit}
#app{min-height:100vh;position:relative;overflow:hidden;background:
 radial-gradient(circle at 20% 20%,rgba(255,119,183,.25),transparent 32%),
 radial-gradient(circle at 80% 10%,rgba(155,123,255,.28),transparent 30%),
 linear-gradient(145deg,var(--bg1),var(--bg2) 55%,#180b32)}
.screen{min-height:100vh;display:none;position:relative;padding:30px 18px 44px;z-index:2}
.screen.active{display:flex;animation:screenIn .65s ease both}
#intro{align-items:center;justify-content:center;text-align:center}
.container{width:min(1050px,100%);margin:auto}
.glow{position:absolute;border-radius:50%;filter:blur(55px);opacity:.28;pointer-events:none}
.g1{width:220px;height:220px;background:#ff4fa3;top:-80px;left:-70px}
.g2{width:260px;height:260px;background:#7958ff;right:-100px;bottom:-80px}
.rakhi{font-size:clamp(44px,12vw,80px);filter:drop-shadow(0 0 22px rgba(255,119,183,.5));animation:float 3.2s ease-in-out infinite}
h1,h2,h3{font-family:"Playfair Display",serif}
h1{font-size:clamp(40px,10vw,78px);line-height:1.02;margin:14px 0 14px;background:linear-gradient(90deg,#fff,#ffd6eb,#d8d0ff,#fff);background-size:250%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shine 5s linear infinite}
.subtitle{max-width:650px;margin:0 auto;color:var(--muted);font-size:clamp(16px,4vw,20px);line-height:1.6}
.options{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:30px}
.btn{border:1px solid var(--border);color:#fff;background:rgba(255,255,255,.1);padding:14px 20px;border-radius:999px;cursor:pointer;backdrop-filter:blur(12px);transition:.25s;box-shadow:0 10px 30px rgba(0,0,0,.18)}
.btn:hover,.btn:active{transform:translateY(-3px) scale(1.02);background:rgba(255,255,255,.18)}
.btn.primary{background:linear-gradient(135deg,#ff5da9,#8c6cff);border:0}
.no-btn{position:relative;z-index:10;touch-action:manipulation;transition:transform .22s cubic-bezier(.2,.8,.2,1),left .22s ease,top .22s ease}.no-btn.flee{position:fixed!important;left:var(--x)!important;top:var(--y)!important;transform:scale(1.06) rotate(-4deg)!important}.
.tiny{margin-top:20px;color:rgba(255,255,255,.52);font-size:13px}
#noMsg{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(12,4,25,.72);backdrop-filter:blur(8px);z-index:20;padding:24px;text-align:center}
#noMsg.show{display:flex;animation:fade .3s}
.msgbox{width:min(440px,100%);padding:32px 24px;border-radius:28px;background:rgba(255,255,255,.12);border:1px solid var(--border);box-shadow:0 30px 80px rgba(0,0,0,.35)}
.msgbox .emoji{font-size:48px}
.gift-head{text-align:center;margin-bottom:28px}
.gift-head h2{font-size:clamp(32px,8vw,54px);margin:8px 0}
.gift-head p{color:var(--muted);margin:0}
.cards{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.card{position:relative;overflow:hidden;min-height:310px;border:1px solid var(--border);border-radius:25px;background:var(--glass);backdrop-filter:blur(14px);box-shadow:0 18px 50px rgba(0,0,0,.2);cursor:pointer;transition:.3s}
.card:hover,.card:active{transform:translateY(-7px);box-shadow:0 25px 60px rgba(0,0,0,.3)}
.card-img{height:165px;background:linear-gradient(135deg,rgba(255,119,183,.25),rgba(155,123,255,.3));display:flex;align-items:center;justify-content:center;overflow:hidden}
.card-img img{width:100%;height:100%;object-fit:cover;display:block}
.placeholder{font-size:48px;opacity:.8}
.card-body{padding:17px}
.card h3{margin:0 0 7px;font-size:22px}
.card p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}
.open{margin-top:13px;font-size:13px;color:#ffd9ec;font-weight:700}
.back{margin-bottom:18px}
.modal{position:fixed;inset:0;z-index:30;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(7,2,17,.82);backdrop-filter:blur(14px)}
.modal.show{display:flex;animation:fade .35s}
.modal-box{width:min(720px,100%);max-height:92vh;overflow:auto;border:1px solid var(--border);border-radius:30px;background:linear-gradient(145deg,rgba(53,16,91,.96),rgba(20,11,45,.96));box-shadow:0 30px 100px rgba(0,0,0,.45);position:relative}
.modal-image{height:min(52vh,420px);background:rgba(255,255,255,.07);display:flex;align-items:center;justify-content:center;overflow:hidden}
.modal-image img{width:100%;height:100%;object-fit:cover}
.modal-content{padding:25px}
.modal-content h2{font-size:34px;margin:0 0 10px}
.modal-content p{color:var(--muted);line-height:1.75;margin:0 0 20px}
.close{position:absolute;right:14px;top:14px;width:42px;height:42px;border-radius:50%;border:1px solid var(--border);background:rgba(0,0,0,.3);color:#fff;cursor:pointer;font-size:20px;z-index:2}
.final{font-size:clamp(36px,9vw,65px);margin:0 0 14px}
.confetti{position:fixed;inset:0;pointer-events:none;z-index:50;overflow:hidden}
.confetti i{position:absolute;top:-20px;width:8px;height:14px;animation:fall 2.6s linear forwards}
footer{text-align:center;color:rgba(255,255,255,.45);font-size:12px;margin-top:28px}
@keyframes screenIn{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
@keyframes fade{from{opacity:0}to{opacity:1}}
@keyframes float{50%{transform:translateY(-10px) rotate(2deg)}}
@keyframes shine{to{background-position:250%}}
@keyframes fall{to{transform:translateY(110vh) rotate(720deg);opacity:0}}
@media(max-width:900px){.cards{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.screen{padding:22px 14px 34px}.cards{grid-template-columns:1fr}.card{min-height:340px}.card-img{height:205px}.options .btn{width:100%}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition:none!important}}
</style>
</head>
<body>
<div id="app">
  <div class="glow g1"></div><div class="glow g2"></div>

  <section id="intro" class="screen active">
    <div class="container">
      <div class="rakhi">🎀</div>
      <h1>Happy Raksha Bandhan ❤️</h1>
      <p class="subtitle">A little surprise, made especially for you… because one day a year isn't enough to remind you how special you are.</p>
      <div class="options">
        <button class="btn primary" id="yesBtn">I want to check it 👀</button>
        <button class="btn no-btn" id="noBtn">I don't want to check it 🙈</button>
      </div>
      <div class="tiny">Tap carefully… there's a surprise waiting.</div>
    </div>
  </section>

  <section id="gifts" class="screen">
    <div class="container">
      <div class="gift-head">
        <div class="rakhi" style="font-size:48px">🪢</div>
        <h2>For the Best Sister ❤️</h2>
        <p>Five little surprises, made just for you.</p>
      </div>
      <div class="cards" id="cards"></div>
      <footer>Made with ❤️ for Raksha Bandhan</footer>
    </div>
  </section>
</div>

<div id="noMsg">
  <div class="msgbox">
    <div class="emoji">😏</div>
    <h2>Nice try!</h2>
    <p class="subtitle" style="font-size:16px">But you can't escape that easily. Let's go back and try again!</p>
    <button class="btn primary" id="againBtn">Okay, okay 😄</button>
  </div>
</div>

<div class="modal" id="modal">
  <div class="modal-box">
    <button class="close" id="closeModal" aria-label="Close">×</button>
    <div class="modal-image" id="modalImage"></div>
    <div class="modal-content">
      <h2 id="modalTitle"></h2>
      <p id="modalText"></p>
      <button class="btn primary" id="backBtn">Back to Gifts ❤️</button>
    </div>
  </div>
</div>
<div class="confetti" id="confetti"></div>

